# Casjoe VoiceBiz — Backend Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./voicebiz.db

# ─── Casjoe Biz API ───────────────────────────────────────────────────────────
CASJOE_API_BASE_URL=https://app.casjoe.com/api/v1
CASJOE_JWT_SECRET=your_casjoe_jwt_secret_here

# ─── N-ATLAS (Ollama local) ───────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
N_ATLAS_MODEL=hf.co/QuantFactory/N-ATLaS-GGUF:Q4_K_M

# ─── N-ATLAS (HuggingFace ZeroGPU Space — demo only) ─────────────────────────
# NATLAS_ENDPOINT=https://casjoetech-voicebiz-n-atlas.hf.space/api/predict
# HF_TOKEN=your_huggingface_token_here

# ─── Audio / ASR ──────────────────────────────────────────────────────────────
AUDIO_UPLOAD_DIR=./uploads/audio
WHISPER_MODEL_SIZE=medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
MAX_AUDIO_DURATION_SECONDS=30

# ─── HuggingFace Bucket (evidence storage) ────────────────────────────────────
HF_BUCKET_REPO=casjoetech/N-ATLaS-bucket
# HF_TOKEN=set above

# ─── App Settings ─────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,https://voicebiz.casjoe.com

# ─── Security ─────────────────────────────────────────────────────────────────
SECRET_KEY=change_this_to_a_random_64_char_string_in_production
